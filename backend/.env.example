# Atrás de um proxy HTTPS (produção), escutar só na própria máquina: HOST=127.0.0.1
HOST=
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/baza
JWT_SECRET=troque-este-segredo
# "development" mostra o código OTP no log e na resposta da API
NODE_ENV=development
# Rotas e pesquisa de endereços (servidores públicos, apenas para desenvolvimento)
# ── Mapas ──
# Por omissão usam-se os serviços públicos do OpenStreetMap, que NÃO podem ser
# usados em produção. Com os mapas próprios (pasta mapas/, ver README) use:
#   OSRM_URL=http://127.0.0.1:5000
#   PHOTON_URL=http://127.0.0.1:2322
#   NOMINATIM_URL=
#   TILE_UPSTREAM=http://127.0.0.1:8080/styles/baza/256/{z}/{x}/{y}@2x.png
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Sugestões de locais enquanto se escreve
PHOTON_URL=https://photon.komoot.io
# mock = pagamentos simulados; emis = Multicaixa Express (exige credenciais)
PAYMENT_PROVIDER=mock
EMIS_API_URL=
EMIS_FRAME_TOKEN=

# Documentos dos motoristas (carta de condução e livrete)
# Em desenvolvimento são aprovados automaticamente; em produção ficam "em análise"
# até um administrador os rever no painel web.
AUTO_APPROVE_DOCUMENTS=

# Endereço público do servidor (para os links de partilha de viagem funcionarem
# fora desta máquina) e número de emergência do botão SOS
PUBLIC_URL=
EMERGENCY_NUMBER=111

# Carteira no app (saldo, pagamento por carteira, comissões, levantamentos).
# Desligada por omissão; ligar com true.
WALLET_ENABLED=false
# Partilha do som da viagem num alerta de perigo (o SOS funciona sem ela). Desligada
# por omissão; para ligar ver PRODUCAO.md › Permissões Android do app.
ALERT_AUDIO_ENABLED=false

# Painel web (http://localhost:4000/painel).
# Em desenvolvimento há uma conta por defeito: admin@baza.ao / baza-admin
# (o painel pede para trocar a palavra-passe). Em produção essa conta não é
# criada: defina aqui o primeiro administrador.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMS dos códigos de confirmação (TelcoSMS, Angola). Com a chave definida os SMS
# são enviados a sério e gastam saldo; sem ela, em desenvolvimento, o código
# aparece no ecrã do app. SMS_PROVIDER=console força o modo simulado.
TELCOSMS_API_KEY=
SMS_PROVIDER=
# Só nos testes (modo simulado): números +244… cujo primeiro envio falha, para ensaiar a
# criação de conta sem SMS. Nunca definir em produção.
# SMS_FAIL_NUMBERS=

# E-mail (recuperação de palavra-passe e avisos). Com SMTP_USER definido os
# e-mails são enviados a sério; MAIL_TRANSPORT=console força o modo simulado.
# O remetente tem de ser um endereço do domínio da conta SMTP.
MAIL_TRANSPORT=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_REMETENTE=
SMTP_REMETENTE_NOME=Bazá
SMTP_TIMEOUT=15
# Reserva (Google Apps Script), usada se o SMTP falhar
EMAIL_SERVICE_URL=
EMAIL_SERVICE_PASS=

# Chamadas de voz no app (WebRTC). STUN público por omissão; para as chamadas
# ligarem em todas as redes móveis é preciso um servidor TURN próprio ou contratado.
STUN_URLS=
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Imagens do mapa do nosso servidor de mapas (vazio = mapa público do OpenStreetMap)
TILE_UPSTREAM=

# ── Páginas legais (/termos e /privacidade) ──
# Nome da empresa responsável e contactos mostrados nas páginas.
LEGAL_ENTITY=Bazá Tranquilo
SUPPORT_EMAIL=
SUPPORT_PHONE=

# ── Notificações push (Firebase) ──
# Chave da conta de serviço (Firebase › Definições do projecto › Contas de serviço
# › Gerar nova chave privada). O ficheiro fica fora do git. Sem ele, não há push.
FIREBASE_KEY_FILE=firebase-chave.json

# ── Comissões e mensalidades ──
# A percentagem de comissão e a mensalidade por tipo de viatura definem-se no
# painel (Comissões / Mensalidades). Aqui ficam as regras:
# Bloquear quem deve comissões acima do limite (por omissão só se regista a dívida)
COMMISSION_ENFORCED=false
COMMISSION_DEBT_LIMIT=5000
# Texto mostrado ao motorista sobre como pagar (conta bancária, local, contacto)
COMMISSION_PAY_INFO=
# Dias grátis de uma viatura de preço combinado, a contar da 1.ª vez que fica online
SUBSCRIPTION_TRIAL_DAYS=30

# ── Cancelamentos ──
CANCEL_GRACE_SECONDS=120
CANCEL_MAX_LATE=3
CANCEL_SUSPEND_MINUTES=30

# Locais de utilizadores estrela só aparecem depois de aprovados no painel
STAR_PLACES_NEED_APPROVAL=false
# Enviar também o recibo da corrida por SMS (gasta saldo; por e-mail é sempre enviado)
RECEIPT_SMS=false

# Saldo pré-pago dos motoristas e referências de pagamento (ver PRODUCAO.md)
DRIVER_FREE_RIDES=10
REFERENCE_PROVIDER=simulado
# off | testers | all  (simulação: sem dinheiro real)
PAYMENT_SIMULATION=off
PAYMENT_SIM_PHONES=
PAYMENT_SIM_DELAY_S=20
REFERENCE_TTL_HOURS=48
# Canal do código de entrada, como o app o escreve ("enviámos por SMS")
OTP_CHANNEL_LABEL=SMS

# Contas de revisão da Google Play: só senha, nunca SMS (ver PLAY_STORE.md)
REVIEW_PHONES=
